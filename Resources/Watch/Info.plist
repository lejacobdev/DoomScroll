<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DoomScroll</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>DoomScroll uses Bluetooth as a backup connection to your Mac when Wi-Fi is not available.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_doomscroll._tcp</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>DoomScroll starts a workout session only to keep scrolling responsive while your wrist is down. No health data is read.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>DoomScroll starts a workout session only to keep scrolling responsive while your wrist is down. No workout is saved.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DoomScroll connects to your Mac on your local network to scroll it from your wrist.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(DOOMSCROLL_BUNDLE_PREFIX)</string>
</dict>
</plist>
