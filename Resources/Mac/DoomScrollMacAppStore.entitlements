<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used only by release-mac-testflight.yml (TestFlight / Mac App Store builds).
	     The Developer ID build keeps DoomScrollMac.entitlements, which is unsandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Listens for the paired iPhone/Watch over TCP and advertises over Bonjour. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
